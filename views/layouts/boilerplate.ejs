<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Genathon 3.0 - Organized by Club Elevate, IIIT Nagpur</title>
  <link rel="icon" href="/favicon.png" type="image/png" />
  <meta
    name="description"
    content="Join Genathon 3.0, the premier hackathon organized by Club Elevate at IIIT Nagpur. February 7-9, 2026. Register now!"
  />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap"
    rel="stylesheet"
  />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- GSAP -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

  <!-- Lenis Smooth Scroll -->
  <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.27/bundled/lenis.min.js"></script>

  <!-- Heroicons -->
  <script
    src="https://unpkg.com/heroicons@2.0.18/24/outline/index.js"
    type="module"
  ></script>

  <!-- Custom Styles -->
  <link rel="stylesheet" href="/css/style.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            inter: ["Inter", "sans-serif"],
          },
          colors: {
            "dark-bg": "#0D0D0D",
            "primary-red": "#FF4F5A",
            "primary-purple": "#6A00FF",
            "red-bg": "#FF2E4C",
            "input-bg": "#1C1C1C",
            "binary-gray": "#AAAAAA",
            "muted-gray": "#A0A0A0",
          },
        },
      },
    };
  </script>
</head>
<body class="font-inter bg-dark-bg text-white overflow-x-hidden">
  <canvas
    id="binaryCanvas"
    class="fixed inset-0 z-0 pointer-events-none"
  ></canvas>

  <% const navbarHidden = typeof hideNavbar !== "undefined" ? hideNavbar : false; %>
  <%- include("../includes/navbar.ejs", { hideNavbar: navbarHidden }) %>

  <main>
    <%- body %>
  </main>

  <% const footerHidden = typeof hideNavbar !== "undefined" ? hideNavbar : false; %>
  <%- include("../includes/footer.ejs", { hideNavbar: footerHidden }) %>

  <script src="/js/script.js"></script>
      <script src="app.js"></script>
<!-- Lightbox Modal -->
<div id="lightbox" class="fixed inset-0 bg-black bg-opacity-90 hidden items-center justify-center z-50">
  <button onclick="closeLightbox()" class="absolute top-6 right-6 text-white text-3xl">&times;</button>
  <img id="lightboxImage" src="" alt="Preview" class="max-w-full max-h-[80vh] rounded shadow-lg">
  <!-- Arrows -->
  <button onclick="prevImage()" class="absolute left-4 text-white text-4xl">&#8592;</button>
  <button onclick="nextImage()" class="absolute right-4 text-white text-4xl">&#8594;</button>
</div>

<script>
  const images = [
    "images/genp1.jpg",
    "images/genp2.jpg",
    "images/genp3.jpg"
  ];
  let currentIndex = 0;

  function openLightbox(index) {
    currentIndex = index;
    document.getElementById('lightboxImage').src = images[index];
    document.getElementById('lightbox').classList.remove('hidden');
    document.getElementById('lightbox').classList.add('flex');
  }

  function closeLightbox() {
    document.getElementById('lightbox').classList.add('hidden');
  }

  function nextImage() {
    currentIndex = (currentIndex + 1) % images.length;
    document.getElementById('lightboxImage').src = images[currentIndex];
  }

  function prevImage() {
    currentIndex = (currentIndex - 1 + images.length) % images.length;
    document.getElementById('lightboxImage').src = images[currentIndex];
  }
</script>
</body>
</html>
