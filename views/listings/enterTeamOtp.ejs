<% layout("/layouts/boilerplate") %>

<section class="min-h-screen flex flex-col justify-center items-center px-4">
  <h1 class="text-2xl font-bold mb-6 text-center text-purple-700">Verify Team OTP</h1>

  <p class="mb-2 text-center text-lg">
    OTP sent for team: <strong><%= teamName %></strong>
  </p>

  <form method="POST" action="/team/verify-otp" class="w-full max-w-sm space-y-4">
    <!-- Hidden input for teamName -->
    <input type="hidden" name="teamName" value="<%= teamName %>" />

    <!-- OTP input -->
    <input
      type="text"
      name="otp"
      placeholder="Enter your OTP"
      required
      maxlength="6"
      pattern="\d{6}"
      title="Please enter the 6-digit OTP"
      class="form-input"
    />

    <button
      type="submit"
      class="w-full bg-purple-700 hover:bg-purple-800 text-white font-bold py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 glow-purple-button"
    >
      Verify OTP
    </button>
  </form>
</section>
