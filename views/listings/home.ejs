<% layout("/layouts/boilerplate.ejs") %>
<body>
    <main class="relative z-10">
        <!-- Hero Section -->
        <section id="home" class="min-h-screen flex items-center px-4 lg:px-8">
            <div class="max-w-7xl mx-auto w-full">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <!-- Left Side - Logo and Info -->
                    <div class="text-center lg:text-left">
                        <div class="logo-container mb-8">
                            <h1 class="text-6xl lg:text-8xl font-black tracking-tighter mb-4">
                                GENATHON
                            </h1>
                            <div class="version-number text-4xl lg:text-6xl font-black text-purple-500 glow-red">
                                3.0
                            </div>
                        </div>
                        <div class="space-y-4 mb-8">
                            <p class="text-xl lg:text-2xl text-muted-gray">
                                Organized by <span class="text-white font-semibold">Club Elevate, IIIT Nagpur</span>
                            </p>
                            <p class="text-lg lg:text-xl text-purple-500 font-medium">
                                October 10–11, 2025
                            </p>
                        </div>
                    </div>
                    
                    <!-- Right Side - Registration Form -->
                    <div class="w-full max-w-md mx-auto lg:mx-0 lg:ml-auto">
                        <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-8 border border-white/10">
                            <h2 class="text-2xl font-bold mb-6 text-center">Pre-register Now</h2>
                            <form id="registrationForm" class="space-y-4" action="/listings" method="POST">
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <input type="text" name="firstName" placeholder="First Name*" required 
                                               class="form-input" >
                                    </div>
                                    <div>
                                        <input type="text" name="lastName" placeholder="Last Name*" required 
                                               class="form-input" >
                                    </div>
                                </div>
                                <input type="email" name="email" placeholder="Email*" required 
                                       class="form-input" >
                                <input type="tel" name="phone" placeholder="Phone Number*" required 
                                       class="form-input" minlength="10" maxlength="10">
                                <input type="number" name="age" placeholder="Age*" required
                                           class="form-input">
                                <!-- <div class="grid grid-cols-2 gap-4">
                                    
                                    <select name="level" required class="form-input">
                                        <option value="">Level of Study*</option>
                                        <option value="High School">High School</option>
                                        <option value="Undergraduate">Undergraduate</option>
                                        <option value="Graduate">Graduate</option>
                                        <option value="PhD">PhD</option>
                                        <option value="Professional">Professional</option>
                                    </select>
                                </div> -->
                                <input type="text" name="college" placeholder="College/Institute*" required 
                                       class="form-input">
                                <input type="url" name="linkedin" placeholder="LinkedIn URL*" required 
                                       class="form-input">
                                <input type="text" name="country" placeholder="Country of Residence*" required 
                                       class="form-input">
                                <button  class="w-full bg-purple-700 hover:bg-purple-800 text-white font-bold py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 glow-purple-button">
                                    Register Now
                                </button>
                                <a href="/alreadyRegistered" class="w-full block text-center bg-transparant-700 hover:bg-rose-600 text-white font-bold py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 hover-text-change">
                                </a>
                                 
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Statistics Section -->
       <section id="about" class="py-20 relative overflow-hidden">
        <div class="stats-bg absolute inset-0 bg-purple-700 transform -skew-y-2"></div>
        <div class="relative z-10 max-w-6xl mx-auto px-4">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
            <div class="stat-item">
                <div class="stat-number text-4xl lg:text-6xl font-black text-white mb-2" data-target="500">0</div>
                <div class="text-lg lg:text-xl font-semibold text-white/90">Registrations</div>
            </div>
            <div class="stat-item">
                <div class="stat-number text-4xl lg:text-6xl font-black text-white mb-2" data-target="400">0</div>
                <div class="text-lg lg:text-xl font-semibold text-white/90">Participants</div>
            </div>
            <div class="stat-item">
                <div class="stat-number text-4xl lg:text-6xl font-black text-white mb-2" data-target="120">0</div>
                <div class="text-lg lg:text-xl font-semibold text-white/90">Projects</div>
            </div>
            <div class="stat-item">
                <div class="stat-number text-4xl lg:text-6xl font-black text-white mb-2" data-target="100">0</div>
                <div class="text-lg lg:text-xl font-semibold text-white/90">Volunteers</div>
            </div>
            </div>
        </div>
        </section>
        
        <!-- Why Participate Section -->
        <section class="py-20 px-4">
            <div class="max-w-6xl mx-auto">
                <h2 class="text-4xl lg:text-5xl font-bold text-center mb-16">
                    Why Participate in <span class="text-purple-500">Genathon 3.0</span>?
                </h2>
                <div class="grid lg:grid-cols-3 gap-8">
                    <div class="floating-card group">
                        <div class="bg-gradient-to-br from-primary-purple/20 to-primary-purple/5 backdrop-blur-sm rounded-2xl p-8 border border-primary-purple/30 h-full transform transition-all duration-500 hover:scale-105 hover:rotate-1 glow-purple">
                            <div class="w-16 h-16 bg-primary-purple/20 rounded-full flex items-center justify-center mb-6 mx-auto">
                                <svg class="w-8 h-8 text-primary-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-bold text-center mb-4">Collaborate and Skill Up</h3>
                            <p class="text-muted-gray text-center leading-relaxed">
                                Connect with people, form a team, learn new skills and develop amazing projects!
                            </p>
                        </div>
                    </div>
                    
                    <div class="floating-card group">
                        <div class="bg-gradient-to-br from-primary-purple/20 to-primary-purple/5 backdrop-blur-sm rounded-2xl p-8 border border-primary-purple/30 h-full transform transition-all duration-500 hover:scale-105 hover:-rotate-1 glow-purple">
                            <div class="w-16 h-16 bg-primary-purple/20 rounded-full flex items-center justify-center mb-6 mx-auto">
                                <svg class="w-8 h-8 text-primary-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-bold text-center mb-4">Exciting Prizes!</h3>
                            <p class="text-muted-gray text-center leading-relaxed">
                                Top 3 teams plus best projects of each domain will win prizes which will be disclosed soon!
                            </p>
                        </div>
                    </div>
                    
                    <div class="floating-card group">
                        <div class="bg-gradient-to-br from-primary-purple/20 to-primary-purple/5 backdrop-blur-sm rounded-2xl p-8 border border-primary-purple/30 h-full transform transition-all duration-500 hover:scale-105 hover:rotate-1 glow-purple">
                            <div class="w-16 h-16 bg-primary-purple/20 rounded-full flex items-center justify-center mb-6 mx-auto">
                                <svg class="w-8 h-8 text-primary-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-bold text-center mb-4">Engaging Workshops</h3>
                            <p class="text-muted-gray text-center leading-relaxed">
                                Technical workshops and events like no-light event will keep the participants engaged throughout.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Guidelines Section -->
        <section id="register" class="py-20 px-4">
            <div class="max-w-6xl mx-auto">
                <h2 class="text-4xl lg:text-5xl font-bold text-center mb-16">
                    Guidelines for <span class="text-purple-500">Genathon 3.0</span>
                </h2>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Register with Ease -->
                    <div class="guideline-item">
                        <div class="w-16 h-16 bg-orange-500 rounded-full flex items-center justify-center mb-6 mx-auto">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-center mb-4">Register with Ease</h3>
                        <p class="text-muted-gray text-center">Pre-registration opens shortly—no red tape, just one click away!</p>
                    </div>
                    
                    <!-- No Prerequisites -->
                    <div class="guideline-item">
                        <div class="w-16 h-16 bg-blue-500 rounded-full flex items-center justify-center mb-6 mx-auto">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-center mb-4">No Prerequisites</h3>
                        <p class="text-muted-gray text-center">Anyone can join, no prerequisites—just bring your creativity!</p>
                    </div>
                    
                    <!-- Form Team -->
                    <div class="guideline-item">
                        <div class="w-16 h-16 bg-primary-purple rounded-full flex items-center justify-center mb-6 mx-auto">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-center mb-4">Form Team</h3>
                        <p class="text-muted-gray text-center">Team up with 2-4 members; join our Discord to find teammates and get the latest updates!</p>
                    </div>
                    
                    <!-- Flexible Teams -->
                    <div class="guideline-item">
                        <div class="w-16 h-16 bg-green-500 rounded-full flex items-center justify-center mb-6 mx-auto">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-center mb-4">Flexible Teams</h3>
                        <p class="text-muted-gray text-center">Add teammates later by submitting an individual application, and they'll be added once approved.</p>
                    </div>
                    
                    <!-- Zero Fees -->
                    <div class="guideline-item">
                        <div class="w-16 h-16 bg-purple-500 rounded-full flex items-center justify-center mb-6 mx-auto">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-center mb-4">Zero Fees, Full Perks</h3>
                        <p class="text-muted-gray text-center">No cost to participate, plus free meals and accommodation throughout the event.</p>
                    </div>
                    
                    <!-- Free Food -->
                    <div class="guideline-item">
                        <div class="w-16 h-16 bg-yellow-500 rounded-full flex items-center justify-center mb-6 mx-auto">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.701 2.701 0 00-1.5-.454M9 6v2m3-2v2m3-2v2M9 3h.01M12 3h.01M15 3h.01M21 21v-7a2 2 0 00-2-2H5a2 2 0 00-2 2v7h18zM3 9a2 2 0 012-2h14a2 2 0 012 2v2H3V9z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-center mb-4">Free Food</h3>
                        <p class="text-muted-gray text-center">Enjoy complimentary meals, water, and coffee throughout the event.</p>
                    </div>
                </div>
            </div>
        </section>

        <!--TimeLine Section-->
       <div class="w-full max-w-4xl mx-auto px-4 py-16" id="timeline">
        <!-- Header -->
        <div class="text-center mb-16">
            <h2 class="text-4xl lg:text-5xl font-bold mb-8">
                Hackathon <span class="text-purple-500">Timeline</span>
            </h2>
            <p class="text-lg text-muted-gray mb-12">
                Follow our exciting journey from registration to the grand finale.
            </p>
        </div>

        <!-- Timeline Container -->
        <div class="bg-white/5 backdrop-blur-md border border-purple-500/30 shadow-xl rounded-3xl p-6 md:p-10 w-full max-w-xl mx-auto text-center mb-16">
        <h1 class="text-2xl md:text-3xl font-bold mb-6 glow text-purple-400">
            Countdown to <span class="text-white">Genathon 3.0</span>
        </h1>
        <div id="timer" class="grid grid-cols-4 gap-4 justify-center text-lg md:text-2xl font-semibold">
            <div class="bg-white/10 rounded-xl p-4 shadow border border-purple-500/20">
            <div id="days">00</div>
            <p class="text-xs md:text-sm font-medium mt-1">Days</p>
            </div>
            <div class="bg-white/10 rounded-xl p-4 shadow border border-purple-500/20">
            <div id="hours">00</div>
            <p class="text-xs md:text-sm font-medium mt-1">Hours</p>
            </div>
            <div class="bg-white/10 rounded-xl p-4 shadow border border-purple-500/20">
            <div id="minutes">00</div>
            <p class="text-xs md:text-sm font-medium mt-1">Minutes</p>
            </div>
            <div class="bg-white/10 rounded-xl p-4 shadow border border-purple-500/20">
            <div id="seconds">00</div>
            <p class="text-xs md:text-sm font-medium mt-1">Seconds</p>
            </div>
        </div>
        </div>


        <div class="relative" >
            <!-- Timeline Line -->
            <div class="absolute left-8 md:left-1/2 transform md:-translate-x-px h-full w-0.5 bg-gradient-to-b from-blue-400 via-purple-500 to-pink-500"></div>

            <!-- Timeline Events -->
            <div class="space-y-12">
                <!-- Event 1: Registration Opens -->
                <div class="relative flex items-center md:flex-row flex-row timeline-event" data-status="upcoming">
                    <!-- Timeline Dot -->
                    <div class="absolute left-8 md:left-1/2 transform md:-translate-x-1/2 z-10">
                        <div class="timeline-dot w-16 h-16 rounded-full border-4 border-gray-400 bg-gradient-to-br from-gray-400 to-gray-500 flex items-center justify-center">
                            <!-- Users Icon -->
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                            </svg>
                        </div>
                    </div>

                    <!-- Event Card -->
                    <div class="ml-28 md:ml-0 md:w-5/12 md:mr-auto md:pr-8">
                        <div class="timeline-card bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-6 hover:bg-white/20 hover:border-white/30 hover:shadow-xl hover:shadow-blue-500/10">
                            <div class="flex items-center justify-between mb-3">
                                <h3 class="text-xl font-bold text-white">Registration Opens</h3>
                                <span class="px-3 py-1 rounded-full text-xs font-medium bg-gray-500/20 text-gray-300 border border-gray-500/30">upcoming</span>
                            </div>
                            <div class="flex items-center text-gray-300 mb-3 space-x-4">
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    September 1, 2025
                                </span>
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    All Day
                                </span>
                            </div>
                            <p class="text-gray-300 leading-relaxed">Registration portal opens for all participants. Form your teams and get ready for the challenge!</p>
                        </div>
                    </div>
                </div>

                <!-- Event 2: Online Quiz Round -->
                <div class="relative flex items-center md:flex-row-reverse flex-row timeline-event" data-status="upcoming">
                    <div class="absolute left-8 md:left-1/2 transform md:-translate-x-1/2 z-10">
                        <div class="timeline-dot w-16 h-16 rounded-full border-4 border-gray-400 bg-gradient-to-br from-gray-400 to-gray-500 flex items-center justify-center">
                            <!-- Quiz Icon -->
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-28 md:ml-0 md:w-5/12 md:ml-auto md:pl-8">
                        <div class="timeline-card bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-6 hover:bg-white/20 hover:border-white/30 hover:shadow-xl hover:shadow-blue-500/10">
                            <div class="flex items-center justify-between mb-3">
                                <h3 class="text-xl font-bold text-white">Online Quiz Round</h3>
                                <span class="px-3 py-1 rounded-full text-xs font-medium bg-gray-500/20 text-gray-300 border border-gray-500/30">upcoming</span>
                            </div>
                            <div class="flex items-center text-gray-300 mb-3 space-x-4">
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    October 1, 2025
                                </span>
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    9:00 PM
                                </span>
                            </div>
                            <p class="text-gray-300 leading-relaxed">First elimination round - online quiz to test your technical knowledge and problem-solving skills</p>
                        </div>
                    </div>
                </div>

                <!-- Event 3: Campus Round Begins -->
                <div class="relative flex items-center md:flex-row flex-row timeline-event" data-status="upcoming">
                    <div class="absolute left-8 md:left-1/2 transform md:-translate-x-1/2 z-10">
                        <div class="timeline-dot w-16 h-16 rounded-full border-4 border-gray-400 bg-gradient-to-br from-gray-400 to-gray-500 flex items-center justify-center">
                            <!-- Campus Icon -->
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="ml-28 md:ml-0 md:w-5/12 md:mr-auto md:pr-8">
                        <div class="timeline-card bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-6 hover:bg-white/20 hover:border-white/30 hover:shadow-xl hover:shadow-blue-500/10">
