<% layout("/layouts/boilerplate") %>

<main class="min-h-screen bg-dark-bg flex flex-col items-center justify-center text-white px-4">
  <div class="text-center">
    <h1 class="text-6xl font-bold text-green-400 mb-4">✅</h1>
    <h2 class="text-3xl font-semibold mb-2">Registration Successful!</h2>
    <p class="text-lg text-gray-300 mb-6">
      Welcome, <span class="text-white font-bold"><%= name %></span> 🎉<br>
      We've received your details.
    </p>
    <a href="/" class="inline-block bg-purple-700 hover:bg-purple-800 transition px-6 py-2 rounded-full text-white font-medium">Back to Home</a>
  </div>
</main>
