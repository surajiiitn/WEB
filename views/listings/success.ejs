<% layout("/layouts/boilerplate") %>

<section class="min-h-screen flex flex-col justify-center items-center px-4 py-10">
  <h1 class="text-3xl font-bold mb-6 text-center text-purple-700">
    <% if (typeof alreadyRegistered !== 'undefined' && alreadyRegistered) { %>
      You are Already Registered!
    <% } else { %>
      Registration Successful!
    <% } %>
  </h1>

  <p class="mb-4 text-center text-lg">
    <% if (typeof alreadyRegistered !== 'undefined' && alreadyRegistered) { %>
      Welcome back, <%= name %>! You can create your team now.
    <% } else { %>
      Thank you, <%= name %>! Your registration is complete.
    <% } %>
  </p>

  <p class="mb-8 text-center text-sm text-gray-500">
    You can now create your team from your leader account.
  </p>

  <div class="flex gap-6">
    <a href="/" class="bg-gray-500 hover:bg-gray-600 text-white font-semibold py-2 px-6 rounded-lg transition">
      Back to Home
    </a>

    <a href="/team/register" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 px-6 rounded-lg transition">
      Create Team
    </a>
  </div>
</section>
