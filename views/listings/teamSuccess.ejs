<% layout("/layouts/boilerplate") %>

<section class="min-h-screen flex items-center justify-center bg-gradient-to-br from-black via-gray-900 to-black px-4 py-20">
  <div class="bg-white/5 backdrop-blur-md p-10 rounded-2xl border border-white/10 max-w-xl w-full text-center shadow-xl">

    <h1 class="text-3xl font-bold text-green-400 mb-4">🎉 Team Registered Successfully!</h1>
    <p class="text-white text-lg mb-6">
      Congratulations! Your team "<span class="font-semibold text-purple-400"><%= teamName %></span>" has been successfully registered for <span class="text-yellow-300">Genathon 3.0</span>.
    </p>

    <p class="text-sm text-gray-300 mb-6">
      Confirmation emails have been sent to all your team members.
    </p>

    <a href="/" class="inline-block bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105">
      Go to Homepage
    </a>
  </div>
</section>
